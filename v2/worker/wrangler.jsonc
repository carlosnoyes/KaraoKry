// KaraoKry's song server: https://karaokry-songs.karaokry.workers.dev
// Deploy from this folder with `npx wrangler@4 deploy`. Secrets are set with
// `npx wrangler@4 secret bulk <file>` (ACCESS_CODE, SIGNING_KEY, ADMIN_KEY) and are kept on
// Carlos's PC in C:\Users\Carlos\KaraoKry-songs\secrets, never in this repo.
{
	"name": "karaokry-songs",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"r2_buckets": [
		{ "binding": "SONGS", "bucket_name": "karaokry-songs" }
	],
	// Sign-ins: at most 30 a minute from one address (a party on one Wi-Fi shares an address),
	// which makes guessing a 12-character code hopeless.
	"ratelimits": [
		{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
	],
	"vars": {
		// Web pages allowed to read the songs (localhost is always allowed for development).
		"ALLOWED_ORIGINS": "https://carlosnoyes.github.io",
		"TOKEN_HOURS": "12"
	},
	"observability": { "enabled": true }
}
